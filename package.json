{
  "name": "cuaderno-de-viajes",
  "productName": "Cuaderno de viajes",
  "version": "1.0.0",
  "description": "Organizador de viajes: reservas, billetes, mapa, correos, maleta y gastos.",
  "author": "Gonzalo",
  "license": "UNLICENSED",
  "private": true,
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "serve": "node tools/serve.mjs",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "@xmldom/xmldom": "^0.9.8",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "jszip": "^3.10.1"
  },
  "build": {
    "appId": "es.gonzalo.cuadernodeviajes",
    "productName": "Cuaderno de viajes",
    "copyright": "Hecho con cariño para mamá",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": [
      "desktop/**/*",
      "web/**/*",
      "package.json"
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.png",
      "artifactName": "Cuaderno-de-viajes-${version}-instalador.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Cuaderno de viajes",
      "language": "3082",
      "installerLanguages": ["es_ES"],
      "runAfterFinish": true
    }
  }
}
